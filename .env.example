# Required for local LLM curation.
OPENAI_API_KEY=your-api-key

# Optional. Leave empty to use the OpenAI SDK default endpoint.
# Set this for another OpenAI-compatible provider.
OPENAI_BASE_URL=

# Optional. Overrides llm.model and llm.model_editorial in config.yaml.
AI_NEWS_MODEL=

# Optional. TypeSafe System One (Jev) assist. Code reads only this env var.
# Production: Cursor Cloud Agents → Secrets → Runtime Secret TYPESAFE_API_KEY
# (saved Environment or repo-scoped). Bot box-secrets do not reach CA VMs.
# Never commit the value. Missing key fail-opens the original daily flow.
TYPESAFE_API_KEY=

# Canonical disable (checked before any Jev HTTP). Daily still runs.
# JEV_ASSIST=0

# Optional. Host-local durable root (日刊: delivery/jev-private as
# AI_DAILY_PRIVATE_RUN_DIR). Not mounted into CA VMs. Cross-CA handoff is
# files attach + --store; two CAs using runs/jev/ are not sharing state.
# See generation/CA-JEV-ASSIST.md. Unreadable state skips Jev (no fresh 100).
# AI_DAILY_PRIVATE_RUN_DIR=
